{
  "name": "jobradar",
  "version": "0.1.0",
  "description": "Open-source job aggregator over public ATS APIs (Greenhouse, Lever, Ashby, SmartRecruiters) with ghost-job risk scoring. No scraping, no logins - official public endpoints only.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "probe": "tsx src/cli.ts probe",
    "fetch": "tsx src/cli.ts fetch",
    "report": "tsx src/cli.ts report",
    "stats": "tsx src/cli.ts stats",
    "feed": "tsx src/cli.ts feed",
    "sync": "tsx src/cli.ts sync",
    "rank": "tsx src/cli.ts rank",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4"
  }
}
