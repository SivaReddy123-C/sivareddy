{
  "manifest_version": 3,
  "name": "JobRadar Assist",
  "version": "0.1.0",
  "description": "Autofills job application forms from your JobRadar data - automatic on Greenhouse/Lever/Ashby, on-demand on any other site via the popup. You review every field and click Submit yourself - it never submits anything.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobRadar Assist"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sivareddy123-c.github.io/*"
      ],
      "js": [
        "sync.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*"
      ],
      "js": [
        "fill.js"
      ],
      "run_at": "document_idle"
    }
  ]
}